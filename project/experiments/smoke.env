# smoke.env — Smoke-Test-Profil (NUR Funktionsprüfung, KEINE belastbaren Zahlen)
#
# Zweck: Pipeline validieren (SSH-Key-Auth, Deploy, Benchmark-Aufruf, fio/jq-
# Parsing, Median/Delta, CSV-Schreiben) BEVOR der Host-Determinismus
# (C-States/Turbo/Governor, siehe ../notes/PoC.md) steht.
# Aufruf:  ./run_experiment.sh --config smoke.env
#          ./run_fallback.sh   --config smoke.env
# Nach erfolgreicher Validierung wieder config.env (volle Parameter) nutzen.
#
# Unterschiede zu config.env: deutlich kürzere Läufe + weniger Wiederholungen.
# SSH-Ziele/Topologie identisch — daher hier 1:1 übernommen.

# --- SSH-Ziele (Gastsysteme unter Proxmox) ---------------------------------
ATTACKER_HOST="192.168.178.200"  # Angreifer-Gast (LXC 200)
ATTACKER_USER="root"
VICTIM_HOST="192.168.178.203"    # Smoke-Test gegen schnelles Opfer (KVM 203);
VICTIM_USER="root"               # QEMU-Opfer (201) ist als Emulation sehr zäh.

# Fallback-Vergleich: fürs Smoke-Profil reicht ein schnelles Opfer, damit die
# Mechanik geprüft wird, ohne die langsame Emulation (201) abzuwarten. Für den
# echten Lauf in config.env stehen alle drei Paradigmen.
FALLBACK_VICTIMS=(
    "LXC:192.168.178.202"    # Para-Virtualisierung (schnell)
    "KVM:192.168.178.203"    # Hardware-Virtualisierung (schnell)
)

SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"
REMOTE_DIR="/opt/nn-experiments"

# --- Versuchsparameter (verkürzt) ------------------------------------------
REPEATS=2                        # nur Mechanik prüfen (statt 10)

TASKSET_CPU=""                   # Pinning erfolgt host-seitig (Proxmox-Affinity)

# --- Opfer-Benchmark (sysbench / fio) — kurze Läufe ------------------------
SYSBENCH_CPU_PRIME=5000          # statt 20000
SYSBENCH_TIME=5                  # statt 30
SYSBENCH_MEM_TOTAL="2G"          # statt 10G
FIO_SIZE="128M"                  # statt 512M
FIO_RUNTIME=5                    # statt 30
FIO_IODEPTH=16

# --- Angreifer-Störlast (stress-ng) — kurzes Schreibvolumen ----------------
ATTACKER_CACHE_WORKERS=2
ATTACKER_CACHE_LEVEL=3
ATTACKER_HDD_WORKERS=1
ATTACKER_HDD_BYTES="256M"        # statt 1G
