# demo.env — Profil für die LIVE-Demo in der Präsentation.
# Ziel: in ~30–45 s zeigen, DASS die Pipeline echt läuft — KEINE belastbaren Zahlen.
#
# Vor dem Vortrag (einmalig, nimmt apt + Host-Key-Trust aus dem Live-Teil):
#   ./run_experiment.sh --config demo.env --install --deploy-only
# Live (nur die Messung):
#   ./run_experiment.sh --config demo.env --no-deploy
#
# Bewusst PoC-only (run_experiment.sh, EIN Opfer) statt Fallback — wenigste
# beweglichen Teile. Host-Determinismus ist hier irrelevant (Zahlen zählen nicht).
# Die echten Deltas stehen auf der Ergebnis-Folie / im Paper.

# --- SSH-Ziele -------------------------------------------------------------
ATTACKER_HOST="192.168.178.210"  # Angreifer-Gast (LXC 300)
ATTACKER_USER="root"
VICTIM_HOST="192.168.178.213"    # NUR KVM-Opfer (schnellstes, stabilstes Ziel)
VICTIM_USER="root"

# Proxmox-Host für den Determinismus-Schnappschuss je Lauf (siehe config.env).
HOST_HOST="192.168.178.50"
HOST_USER="root"

# Nur gesetzt, falls jemand versehentlich run_fallback.sh nutzt (Array darf nicht leer sein).
FALLBACK_VICTIMS=(
    "KVM:192.168.178.213"
)

SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -i /home/max/.ssh/nn_experiment -o IdentitiesOnly=yes"
REMOTE_DIR="/opt/nn-experiments"

# --- Versuchsparameter (minimal) -------------------------------------------
REPEATS=1                        # ein Durchlauf reicht fürs "es läuft"

TASKSET_CPU=""                   # Pinning host-seitig (Proxmox-Affinity)

# --- Opfer-Benchmark (sysbench / fio) — sehr kurz --------------------------
SYSBENCH_CPU_PRIME=5000
SYSBENCH_TIME=5
SYSBENCH_MEM_TOTAL="2G"
FIO_SIZE="128M"
FIO_RUNTIME=5
FIO_IODEPTH=16

# --- Angreifer-Störlast (stress-ng) ----------------------------------------
ATTACKER_CACHE_WORKERS=2
ATTACKER_CACHE_LEVEL=3
ATTACKER_HDD_WORKERS=1
ATTACKER_HDD_BYTES="256M"
