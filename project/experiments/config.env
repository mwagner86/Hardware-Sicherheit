# Konfiguration für die Noisy-Neighbor-Experimente
# Wird von run_experiment.sh auf dem Control-Node (Laptop) eingelesen.
# Kopiere/anpassen und NICHT mit echten Hostnamen committen, falls sensibel.

# --- SSH-Ziele (Gastsysteme unter Proxmox) ---------------------------------
# Statisches IP-Schema (Heimnetz vmbr0): letztes Oktett = VM-/CT-ID.
#   .200 Angreifer (LXC 200) | .201 QEMU-Opfer | .202 LXC-Opfer | .203 KVM-Opfer
ATTACKER_HOST="192.168.178.200"  # Angreifer-Gast (LXC 200)
ATTACKER_USER="root"
VICTIM_HOST="192.168.178.203"    # PoC-Opfer: KVM (203); für Fallback je Opfer setzen
VICTIM_USER="root"

# Fallback-Vergleich (run_fallback.sh): die drei Opfer-Paradigmen.
# Format je Eintrag "Label:Host". Angreifer bleibt konstant ATTACKER_HOST.
# Login-User aller Opfer = VICTIM_USER.
FALLBACK_VICTIMS=(
    "QEMU:192.168.178.201"   # Emulation (KVM aus)
    "LXC:192.168.178.202"    # Para-Virtualisierung
    "KVM:192.168.178.203"    # Hardware-Virtualisierung
)

# Gemeinsame SSH-Optionen (Key-Auth vorausgesetzt; kein Passwort-Prompt)
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"

# Zielverzeichnis auf den Gästen, in das die Skripte ausgerollt werden
REMOTE_DIR="/opt/nn-experiments"

# --- Versuchsparameter ------------------------------------------------------
REPEATS=10                       # Wiederholungen pro Phase (Median wird gebildet)

# Optionales Pinning INNERHALB des Gasts (taskset). Leer lassen, wenn das
# Pinning bereits host-seitig über die Proxmox CPU-Affinity erfolgt.
TASKSET_CPU=""                   # z. B. "0" oder "0,1"

# --- Opfer-Benchmark (sysbench / fio) --------------------------------------
SYSBENCH_CPU_PRIME=20000         # Rechenlast: Primzahlen bis ...
SYSBENCH_TIME=30                 # Laufzeit je sysbench-Lauf (Sekunden)
SYSBENCH_MEM_TOTAL="10G"         # Gesamtvolumen sysbench memory
FIO_SIZE="512M"                  # Größe der fio-Testdatei
FIO_RUNTIME=30                   # Laufzeit fio (Sekunden, time_based)
FIO_IODEPTH=16

# --- Angreifer-Störlast (stress-ng) ----------------------------------------
ATTACKER_CACHE_WORKERS=2         # stress-ng --cache N (LLC-Eviction)
ATTACKER_CACHE_LEVEL=3           # L3 / Last Level Cache
ATTACKER_HDD_WORKERS=1           # stress-ng --hdd N (I/O-Sättigung)
ATTACKER_HDD_BYTES="1G"          # Schreibvolumen pro hdd-Worker
